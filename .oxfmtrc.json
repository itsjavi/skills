{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "sortImports": true,
  "trailingComma": "es5",
  "proseWrap": "always",
  "sortPackageJson": true,
  "ignorePatterns": ["node_modules/", "dist/", "build/", "pnpm-lock.yaml", ".local/", ".pnpm-store/"]
}
