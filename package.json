{
  "type": "module",
  "scripts": {
    "build": "pnpm generate:catalog && mkdir -p .local && pnpm generate:rules > .local/AGENTS.md",
    "format": "oxfmt --write . && sort-package-json",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "generate:rules": "node scripts/generate-agents-rules.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "oxfmt": "^0.67.0",
    "sort-package-json": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@12.3.4"
}
