{
  "name": "@itsjavi/skills",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/sync-plugins.mjs && node scripts/generate-catalog.mjs && mkdir -p .local && node scripts/generate-agents-rules.mjs > .local/AGENTS.md",
    "check": "node scripts/check-plugins.mjs",
    "format": "oxfmt --write . && sort-package-json",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "generate:plugins": "node scripts/sync-plugins.mjs",
    "generate:rules": "node scripts/generate-agents-rules.mjs",
    "test": "node --test tests/*.test.mjs plugins/*/tests/*.test.mjs",
    "test:agent-workspace": "node --test plugins/*/skills/setup-agent-workspace/tests/*.test.mjs plugins/*/skills/setup-agent-workspace/assets/template/.agents/agent-workspace/tests/*.test.mjs",
    "upstream:sync": "node scripts/sync-upstream-skills.mjs && pnpm format",
    "preversion": "npm run check",
    "version": "node scripts/release-version.mjs",
    "version:sync": "node scripts/sync-plugins.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "sort-package-json": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.3.4"
}
