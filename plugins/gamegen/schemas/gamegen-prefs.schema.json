{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameGen project preferences v1",
  "description": "Structural schema; scripts/prefs.py also checks conditional readiness and project-relative paths.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "setup": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["draft", "ready"]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_sections": {
          "type": "array",
          "items": {
            "enum": [
              "game",
              "presentation",
              "art",
              "platforms",
              "input",
              "generation",
              "budget",
              "features",
              "workflow",
              "paths"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["status", "revision", "confirmed_sections", "deferred"],
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "properties": {
        "title": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "description": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "goal": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "genre": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "audience": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "properties": {
            "deliverable": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "content": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "playtime_minutes": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": ["deliverable", "features", "content", "playtime_minutes", "exclusions"],
          "additionalProperties": false
        }
      },
      "required": ["title", "description", "goal", "genre", "audience", "scope"],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "dimension": {
          "enum": [null, "2d", "2.5d", "3d"]
        },
        "rendering": {
          "enum": [null, "sprites", "tiles", "sprites-in-3d", "3d-rendered-sprites", "meshes"]
        },
        "simulation": {
          "enum": [null, "2d", "3d"]
        },
        "camera": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "orientation": {
          "enum": ["landscape", "portrait", "adaptive"]
        },
        "viewport": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "uniqueItems": false
        },
        "pixel_art": {
          "type": "boolean"
        },
        "tile_grid": {
          "enum": [null, "square", "isometric", "hex"]
        },
        "tile_size": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "sprite_directions": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "units": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "forward_axis": {
          "enum": [null, "+X", "-X", "+Y", "-Y", "+Z", "-Z"]
        }
      },
      "required": [
        "dimension",
        "rendering",
        "simulation",
        "camera",
        "orientation",
        "viewport",
        "pixel_art",
        "tile_grid",
        "tile_size",
        "sprite_directions",
        "units",
        "forward_axis"
      ],
      "additionalProperties": false
    },
    "art": {
      "type": "object",
      "properties": {
        "style": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "direction_doc": {
          "type": "string",
          "minLength": 1
        },
        "required_views": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "expressions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "lighting": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "asset_budgets": {
          "type": "object",
          "properties": {
            "hero_triangles": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "materials_per_actor": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "texture_max_px": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "sprite_frame_px": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          },
          "required": ["hero_triangles", "materials_per_actor", "texture_max_px", "sprite_frame_px"],
          "additionalProperties": false
        }
      },
      "required": [
        "style",
        "palette",
        "references",
        "direction_doc",
        "required_views",
        "required_clips",
        "expressions",
        "lighting",
        "asset_budgets"
      ],
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "enum": ["macos", "ios", "windows", "linux", "android", "web"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimum_os": {
          "type": "object",
          "properties": {
            "macos": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "ios": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "windows": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "linux": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "android": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "web": {
              "type": ["string", "null"],
              "minLength": 1
            }
          },
          "required": ["macos", "ios", "windows", "linux", "android", "web"],
          "additionalProperties": false
        },
        "minimum_device": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "target_fps": {
          "enum": [30, 60, 90, 120]
        },
        "memory_budget_mb": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "engine": {
          "const": "godot"
        },
        "engine_version": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "renderer": {
          "enum": [null, "mobile", "gl_compatibility", "forward_plus"]
        }
      },
      "required": [
        "targets",
        "minimum_os",
        "minimum_device",
        "target_fps",
        "memory_budget_mb",
        "engine",
        "engine_version",
        "renderer"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "enum": ["keyboard", "mouse", "controller", "touch"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "touch_layout": {
          "type": "string",
          "minLength": 1
        },
        "swap_sides": {
          "type": "boolean"
        },
        "rebind": {
          "type": "boolean"
        },
        "accessibility": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["methods", "touch_layout", "swap_sides", "rebind", "accessibility"],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "object",
          "properties": {
            "concepts": {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "quality": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quality": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "model", "quality"],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": ["provider", "model", "quality", "fallbacks"],
              "additionalProperties": false
            },
            "textures": {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "quality": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quality": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "model", "quality"],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": ["provider", "model", "quality", "fallbacks"],
              "additionalProperties": false
            },
            "sprites": {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "quality": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quality": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "model", "quality"],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": ["provider", "model", "quality", "fallbacks"],
              "additionalProperties": false
            },
            "animation": {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "quality": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quality": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "model", "quality"],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": ["provider", "model", "quality", "fallbacks"],
              "additionalProperties": false
            },
            "ui": {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "quality": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quality": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "model", "quality"],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": ["provider", "model", "quality", "fallbacks"],
              "additionalProperties": false
            },
            "audio": {
              "type": "object",
              "properties": {
                "provider": {
                  "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "quality": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": ["builtin-gpt-image", "spritecook", "higgsfield", "blender", "local", "none"]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quality": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "model", "quality"],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": ["provider", "model", "quality", "fallbacks"],
              "additionalProperties": false
            }
          },
          "required": ["concepts", "textures", "sprites", "animation", "ui", "audio"],
          "additionalProperties": false
        },
        "higgsfield": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "use_when": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["enabled", "use_when"],
          "additionalProperties": false
        },
        "computer_use": {
          "enum": ["when-needed", "disabled", "requested"]
        },
        "prefer": {
          "const": "mcp-or-cli"
        }
      },
      "required": ["routes", "higgsfield", "computer_use", "prefer"],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "cash_limit": {
          "type": "number",
          "minimum": 0
        },
        "credit_limits": {
          "type": "object",
          "properties": {
            "spritecook": {
              "type": "integer",
              "minimum": 0
            },
            "higgsfield": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["spritecook", "higgsfield"],
          "additionalProperties": false
        },
        "max_attempts_per_asset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_parallel_paid_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "on_limit": {
          "const": "continue-unpaid-work"
        }
      },
      "required": [
        "currency",
        "cash_limit",
        "credit_limits",
        "max_attempts_per_asset",
        "max_parallel_paid_jobs",
        "on_limit"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "network": {
          "enum": ["offline", "online", "hybrid"]
        },
        "players": {
          "type": "integer",
          "minimum": 1
        },
        "save": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "audio": {
          "type": "string",
          "minLength": 1
        },
        "monetization": {
          "type": "string",
          "minLength": 1
        },
        "content_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["network", "players", "save", "languages", "audio", "monetization", "content_constraints"],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "autonomy": {
          "enum": ["assisted", "unattended"]
        },
        "concept_review": {
          "enum": ["user", "agent"]
        },
        "asset_review": {
          "enum": ["user", "agent"]
        },
        "parallel_agents": {
          "type": "integer",
          "minimum": 0
        },
        "tracker": {
          "enum": ["existing", "none", "backlog"]
        },
        "delivery": {
          "enum": ["editor", "local-build", "device", "store"]
        },
        "signing": {
          "enum": ["deferred", "configured"]
        },
        "quality_priority": {
          "enum": ["balanced", "visual", "performance", "speed"]
        },
        "fallback_on_unknown_cost": {
          "const": "unpaid-only"
        }
      },
      "required": [
        "autonomy",
        "concept_review",
        "asset_review",
        "parallel_agents",
        "tracker",
        "delivery",
        "signing",
        "quality_priority",
        "fallback_on_unknown_cost"
      ],
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "game": {
          "type": "string",
          "minLength": 1
        },
        "concepts": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "string",
          "minLength": 1
        },
        "runtime_assets": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "tests": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "game",
        "concepts",
        "sources",
        "runtime_assets",
        "review",
        "tests",
        "tools",
        "artifacts",
        "manifest",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "setup",
    "game",
    "presentation",
    "art",
    "platforms",
    "input",
    "generation",
    "budget",
    "features",
    "workflow",
    "paths"
  ],
  "additionalProperties": false
}
